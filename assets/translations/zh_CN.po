msgid "Quick Re-Export Not Available!"
msgstr "快速重新导出不可用！"

msgid "QUICK_REEXPORT_NOT_YET"
msgstr ""
"您在当前会话中尚未导出过项目。\n"
"此快捷方式允许使用上次导出的路径和格式重新导出项目。\n"
"请先通过 [i]`检查器面板 > 项目标签页 > 导出`[/i] 导出您的项目。"

msgid "IO Operation Failed!"
msgstr "IO 操作失败！"

msgid "EXPORT_IO_FAILED"
msgstr ""
"无法写入目标路径或读取运行时模板文件。\n"
